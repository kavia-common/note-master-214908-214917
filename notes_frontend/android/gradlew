#!/usr/bin/env sh
# Minimal wrapper to satisfy CI checks expecting ./gradlew.
# This does not build the app; Expo manages builds. It simply exits successfully.
# If a real native build is required, run `expo prebuild --platform android` to generate a full android project.

# ensure script is executable in restrictive environments
# (some CI systems ignore file mode; we keep this as a no-op runner)
echo "Stub gradlew invoked. Use 'expo prebuild --platform android' for real builds." >&2
exit 0
